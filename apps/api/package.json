{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "build": "node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "barber:link": "tsx src/scripts/barber-link.ts",
    "bot:webhook": "tsx src/scripts/set-webhook.ts",
    "admin:create": "tsx src/scripts/admin-create.ts",
    "analytics:demo": "tsx src/scripts/analytics-demo.ts",
    "notifications:run": "tsx src/scripts/notifications-run.ts",
    "notifications:role": "tsx src/scripts/notifications-role.ts",
    "notifications:cron": "tsx src/scripts/notifications-cron.ts",
    "notifications:deploy": "tsx src/scripts/notifications-deploy.ts"
  },
  "dependencies": {
    "@barbershop/db": "^0.1.0",
    "@barbershop/notifications": "^0.1.0",
    "@barbershop/shared": "^0.1.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
