# Скопируйте в .env и заполните. .env не коммитится, сюда реальные значения не вписывайте.
# Supabase Dashboard -> кнопка Connect (вверху проекта) -> ORM -> Prisma.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Dashboard -> Project Settings -> API. Только для backend, не для frontend.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

APP_URL="http://localhost:3000"
API_URL="http://localhost:4100"
NEXT_PUBLIC_API_URL="http://localhost:4100"

# Telegram. Токен от @BotFather, только для backend.
TELEGRAM_BOT_TOKEN=""
# Имя бота без @: для ссылок t.me/<bot>?start=... на сайте и в API.
TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# polling — локальная разработка, webhook — production, off — бот выключен.
TELEGRAM_BOT_MODE="off"
# Случайная строка, Telegram присылает её в заголовке X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=""
# Публичный HTTPS-адрес API для регистрации webhook (npm run bot:webhook).
PUBLIC_API_URL=""
# HTTPS-адрес Mini App для кнопок web_app. Пусто — кнопки ведут на сайт.
MINIAPP_URL=""
# Только для разработки Mini App в обычном браузере, в production запрещено
TELEGRAM_DEV_AUTH="false"
# Пусто: Mini App ходит в API через прокси Vite (/api). В production — адрес API.
VITE_API_URL=""

# Edge Function notifications. Оба значения заполняет npm run notifications:role.
# Подключение под ролью notifications_worker (только нужные таблицы и колонки).
NOTIFICATIONS_DB_URL=""
# Секрет заголовка x-cron-secret: Supabase Cron → Edge Function.
NOTIFICATIONS_CRON_SECRET=""
