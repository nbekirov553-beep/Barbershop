    },
    "./format": {
      "types": "./src/format.ts",
      "compiled": "./src/format.js",
      "default": "./src/format.ts"
    },
    "./shop": {
      "types": "./src/shop.ts",
      "compiled": "./src/shop.js",
      "default": "./src/shop.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
