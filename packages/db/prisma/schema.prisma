generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceCategory {
  hair
  beard

  @@map("service_category")
}

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingSource {
  web
  telegram
  admin

  @@map("booking_source")
}

enum TimeOffType {
  day_off
  vacation
  sick_leave
  holiday

  @@map("time_off_type")
}

model Barber {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  photoUrl        String?  @map("photo_url")
  bio             String   @default("")
  experienceYears Int      @default(0) @map("experience_years") @db.SmallInt
  specialties     String[] @default([])
  telegramChatId  BigInt?  @map("telegram_chat_id")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")

  portfolio    PortfolioItem[]
  services     BarberService[]
  workingHours WorkingHours[]
  breaks       Break[]
  timeOff      TimeOff[]
  bookings     Booking[]
  reviews      Review[]
  linkCodes    BarberLinkCode[]

  @@map("barbers")
}

/// Одноразовый код привязки Telegram-чата барбера: t.me/<bot>?start=barber_<code>. Хранится только hash.
model BarberLinkCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String    @map("barber_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("barber_link_codes")
}

model PortfolioItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("portfolio_items")
}

model Service {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String          @default("")
  category    ServiceCategory @default(hair)
  durationMin Int             @map("duration_min")
  price       Int
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")

  barbers         BarberService[]
  bookingServices BookingService[]

  @@map("services")
}

/// Переопределения длительности и цены для конкретного мастера; null = значение из services.
model BarberService {
  barberId    String  @map("barber_id") @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  durationMin Int?    @map("duration_min")
  price       Int?
  isEnabled   Boolean @default(true) @map("is_enabled")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

/// weekday: 0 = воскресенье ... 6 = суббота, как Date.getDay().
model WorkingHours {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
  @@map("working_hours")
}

model Break {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("breaks")
}

/// barber_id = null означает исключение для всего барбершопа.
model TimeOff {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId String?     @map("barber_id") @db.Uuid
  startsAt DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(3)
  type     TimeOffType @default(day_off)
  note     String?

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt])
  @@map("time_off")
}

model Client {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  phone          String   @unique
  telegramId     BigInt?  @unique @map("telegram_id")
  telegramChatId BigInt?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bookings Booking[]
  reviews  Review[]

  @@map("clients")
}

model Booking {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String                    @map("client_id") @db.Uuid
  barberId         String                    @map("barber_id") @db.Uuid
  startsAt         DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime                  @map("ends_at") @db.Timestamptz(3)
  totalPrice       Int                       @map("total_price")
  totalDurationMin Int                       @map("total_duration_min")
  status           BookingStatus             @default(confirmed)
  source           BookingSource             @default(web)
  manageToken      String                    @unique @map("manage_token")
  /// GENERATED ALWAYS AS tstzrange(starts_at, ends_at, '[)'): основа exclusion constraint bookings_no_overlap.
  timeRange        Unsupported("tstzrange")? @map("time_range")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  reminderDaySentAt DateTime? @map("reminder_day_sent_at") @db.Timestamptz(3)
  reminder30mSentAt DateTime? @map("reminder_30m_sent_at") @db.Timestamptz(3)
  reviewRequestedAt DateTime? @map("review_requested_at") @db.Timestamptz(3)
  autoCompletedAt   DateTime? @map("auto_completed_at") @db.Timestamptz(3)

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barber   Barber           @relation(fields: [barberId], references: [id], onDelete: Restrict)
  services BookingService[]
  review   Review?

  @@index([barberId, startsAt])
  @@index([clientId])
  @@index([status, startsAt])
  @@map("bookings")
}

/// Снимок услуги на момент записи: цена и длительность не меняются вместе с прайсом.
model BookingService {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String  @map("booking_id") @db.Uuid
  serviceId   String? @map("service_id") @db.Uuid
  name        String
  durationMin Int     @map("duration_min")
  price       Int

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([barberId, isPublic])
  @@map("reviews")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model AdminUser {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login          String  @unique
  passwordHash   String  @map("password_hash")
  telegramChatId BigInt? @map("telegram_chat_id")

  sessions AdminSession[]

  @@map("admin_users")
}

/// Сессия админки: в cookie — случайный токен, здесь — только его sha256.
model AdminSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}
